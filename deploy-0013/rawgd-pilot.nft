# rawgd-pilot: отдельные таблицы, не затрагивают существующие (nftables уже в этой цепочке на всех узлах).
# Применить:  nft -f rawgd-pilot.nft      Откатить:  nft delete table inet rawgd_pilot; nft delete table ip rawgd_pilot_nat
# Параметры (имя TUN rgd0, порт 47001/udp, адреса клиентов 198.18.0.0/15 = client_net в node.json) должны совпадать с node.json.
# Метки comment используются node-hostfix.sh для проверки загруженной таблицы: не переименовывать без правки скрипта.
#
# ВАЖНО: эта таблица только ЗАПРЕЩАЕТ лишнее клиентам и делает NAT. Разрешить пересылку rgd0 <-> внешний интерфейс
# нужно в вашей собственной цепочке forward (там policy drop; accept в чужой таблице её не отменяет).
# meta skuid "rawgd" разрешается в uid через passwd при загрузке: пользователь rawgd должен существовать до nft -f.
#
# Цикл носителя: QUIC-пакеты узла (udp sport 47001) и любые сокеты процесса rawgd (в т.ч. TCP-носитель) не должны
# уходить на клиентскую подсеть. Туннельные данные это правило не задевает: rawgd пишет IP-пакеты в TUN через fd
# (write на /dev/net/tun), а не через сокет; такие пакеты попадают в ядро как входящие на rgd0 и проходят
# input/forward, но не OUTPUT, поэтому правило OUTPUT по skuid их не видит.

table inet rawgd_pilot {
    chain input {
        type filter hook input priority -10; policy accept;
        # клиенты туннеля не должны попадать на сервисы самого узла (Xray, AWG, бот, БД и т. п.): только ping
        iifname "rgd0" meta l4proto icmp counter accept
        iifname "rgd0" counter drop comment "client->node"
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        # клиенты не должны попадать во внутренние сети (docker, провайдерская сеть ru1 10.130.0.0/24, AWG-подсети, link-local)
        iifname "rgd0" ip daddr { 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 } counter drop comment "client->internal"
        # IPv6 из туннеля не поддерживается: TUN отбрасывает его до записи, это вторая линия защиты
        meta nfproto ipv6 iifname "rgd0" counter drop comment "client-ipv6"
    }
    chain output {
        type filter hook output priority -10; policy accept;
        # защита от зацикливания носителя: QUIC-пакеты узла не должны уходить в собственный туннель
        ip daddr 198.18.0.0/15 udp sport 47001 counter drop comment "carrier-loop-guard"
        # все остальные сокеты пользователя rawgd (TCP-носитель и прочие) тоже не уходят в клиентскую подсеть
        meta skuid "rawgd" ip daddr 198.18.0.0/15 counter drop comment "rawgd-user-no-tunnel"
    }
}

table ip rawgd_pilot_nat {
    chain post {
        type nat hook postrouting priority 100; policy accept;
        ip saddr 198.18.0.0/15 oifname != "rgd0" masquerade comment "rawgd-pilot"
    }
}
