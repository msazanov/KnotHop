[Unit]
Description=rawgd pilot node (test pilot, not production)
After=network-online.target
Wants=network-online.target
# Requires=rawgd-hostfix.service / After=rawgd-hostfix.service добавлять ТОЛЬКО вместе с `node-hostfix.sh persist`:
# юнит создаёт persist, а на узлах его сейчас нет (без него Requires сломает запуск). См. deploy/README.md.

[Service]
Type=simple
User=rawgd
Group=rawgd
EnvironmentFile=-/opt/rawgd-pilot/rawgd.env
ExecStart=/opt/rawgd-pilot/rawgd node --state /opt/rawgd-pilot/state --config /opt/rawgd-pilot/node.json
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/rawgd-pilot/state
ProtectHome=yes
PrivateTmp=yes
# 21.10: жёсткая квота CPU снята владельцем; rawgd уступает Xray/AWG по весу.
# CPUWeight задаёт относительный приоритет при конкуренции, не ограничение скорости.
CPUQuota=
CPUWeight=50
MemoryMax=300M
Nice=10
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
