+        assert_eq!(init.link(&i).unwrap().cipher(), Gcm);
+        assert_eq!(resp.link(&r).unwrap().cipher(), Gcm);
+        assert!(cipher_pair(Cbc, false, Gcm).is_none(), "a default (CBC) node must not take a GCM request");
